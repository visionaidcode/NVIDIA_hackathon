LLM_PROVIDER=nebius            # nebius | openrouter | stub
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
# Takes screenshots. List the models your key can use: GET <LLM_BASE_URL>/models
LLM_MODEL=nvidia/Nemotron-3.5-Super-VL
# OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Speech-to-text. Empty STT_BASE_URL / STT_API_KEY / STT_MODEL reuse the LLM_* values.
# Nebius Token Factory does not accept audio, so speech goes to Sarvam AI saaras:v4 (key: dashboard.sarvam.ai).
# Compare models with: python scripts/stt_compare.py
STT_BASE_URL=https://api.sarvam.ai
STT_API_KEY=
STT_MODEL=saaras:v4
# chat = audio sent to a chat model (e.g. Voxtral on OpenRouter);
# transcriptions = /audio/transcriptions (Whisper-type, e.g. Groq or OpenAI);
# sarvam = Sarvam AI /speech-to-text (saaras models)
STT_API=sarvam
# Optional language hint (Sarvam: ta-IN, en-IN, hi-IN...). Leave empty to let the model detect it.
STT_LANGUAGE=
# Names and products the speech model should listen for (Sarvam saaras:v4 only), comma separated.
# "none" = no key words. Empty = VisionAid, NVIDIA, Nemotron, Nebius, Sarvam.
STT_KEYTERMS=
# Known mishearings rewritten after transcription, "heard=meant; heard=meant". "none" = off.
# Empty = Vision 18 / Vision18 / Equation 18 / VisionA team -> VisionAid team ("aid team" sounds like "eighteen").
STT_FIXES=
# How audio is sent to a chat model: input_audio (OpenAI/OpenRouter style) or audio_url (vLLM / model card style).
AUDIO_BLOCK_FORMAT=input_audio
# Optional extra request body as JSON, e.g. to switch reasoning off or on.
# Check the provider docs for the exact field; it differs between providers.
# Nebius Nemotron VL: thinking off, or it can use the whole answer budget reasoning.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Tuning
WINDOW_SECONDS=30
FRAME_INTERVAL_SECONDS=1
FRAME_MAX_SIDE=1280
JPEG_QUALITY=70
MAX_FRAMES_PER_QUESTION=4
LATENCY_LOG=eval/results/latency.jsonl

# Meeting transcripts (Ctrl+Alt+M). Empty folder = Documents\Saarthi.
TRANSCRIPT_DIR=
# on = read each speaker's name from the meeting screen (one image call when the screen changes)
SPEAKER_NAMES=on

# Who reads answers aloud: human = offline Piper voices (no API), screenreader = NVDA / JAWS,
# else the Windows voice. Human falls back to the screen reader if no voice files are found.
ANSWER_VOICE=human
# Piper voice files (*.onnx + *.onnx.json), one per language, picked by the script of the text.
# Empty = %APPDATA%\Saarthi\voices. Download, e.g.:
#   python -m piper.download_voices --download-dir <VOICE_DIR> en_US-lessac-medium hi_IN-priyamvada-medium
VOICE_DIR=
