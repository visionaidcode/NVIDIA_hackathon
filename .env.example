LLM_PROVIDER=nebius            # nebius | openrouter | stub
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
# Takes screenshots. List the models your key can use: GET <LLM_BASE_URL>/models
LLM_MODEL=nvidia/Nemotron-3.5-Super-VL
# OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Speech-to-text. Empty STT_BASE_URL / STT_API_KEY / STT_MODEL reuse the LLM_* values.
# Nebius Token Factory does not accept audio, so speech goes to Groq Whisper (key: console.groq.com/keys).
# Compare models with: python scripts/stt_compare.py
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# chat = audio sent to a chat model (e.g. Voxtral on OpenRouter);
# transcriptions = /audio/transcriptions (Whisper-type, e.g. Groq or OpenAI)
STT_API=transcriptions
# Optional language hint, e.g. en. Leave empty to let the model detect it.
STT_LANGUAGE=
# How audio is sent to a chat model: input_audio (OpenAI/OpenRouter style) or audio_url (vLLM / model card style).
AUDIO_BLOCK_FORMAT=input_audio
# Optional extra request body as JSON, e.g. to switch reasoning off or on.
# Check the provider docs for the exact field; it differs between providers.
# Nebius Nemotron VL: thinking off, or it can use the whole answer budget reasoning.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

GEMINI_API_KEY=                # Mode 2 only

# Tuning
WINDOW_SECONDS=30
FRAME_INTERVAL_SECONDS=2
FRAME_MAX_SIDE=1280
JPEG_QUALITY=70
MAX_FRAMES_PER_QUESTION=3
LATENCY_LOG=eval/results/latency.jsonl

# Meeting transcripts (Ctrl+Alt+M). Empty folder = Documents\Meeting Assistant.
TRANSCRIPT_DIR=
# on = read each speaker's name from the meeting screen (one image call when the screen changes)
SPEAKER_NAMES=on
